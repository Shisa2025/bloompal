DATABASE_URL=postgresql://user:password@host:5432/bloompal?sslmode=require
# Optional explicit override: disable, require, or verify-full.
# When omitted, the sslmode value in DATABASE_URL is used by the PostgreSQL driver.
DATABASE_SSL_MODE=
# Required by some providers when DATABASE_SSL_MODE=verify-full. Use \n inside one-line secrets.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
ADMIN_SIGNUP_CODE=replace-with-a-long-random-registration-code

# Optional integration-test database. Never point this at production.
TEST_DATABASE_URL=

# Public online room. It is enabled by default; use 0 only as an emergency kill switch.
# Sync and leave use same-origin Next.js APIs and the existing login cookie/DATABASE_URL.
ONLINE_ROOM_ENABLED=1
ROOM_MAX_PLAYERS=8
PRESENCE_TTL_MS=5000
